# Server
PORT=3000
NODE_ENV=development

# Public URLs (no trailing slash) — required for deploy
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# PostgreSQL (Aiven)
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Redis (Upstash)
REDIS_URL=

# Auth / JWT
AT_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional — defaults to ${BACKEND_URL}/auth/google/callback
GOOGLE_CALLBACK_URL=

# Gemini AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_INPUT_COST_PER_MTOK=0.3
AI_OUTPUT_COST_PER_MTOK=2.5

# Production limits
USER_INPUT_MAX_LENGTH=200

# Chat message limits
INTAKE_USER_MESSAGE_LIMIT=15
SECTION_USER_MESSAGE_LIMIT=20

# Mood / Emotion API (Hugging Face)
# Optional — defaults to the hosted HF Space predict endpoint
MOOD_API_URL=

# Email (SMTP)
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
